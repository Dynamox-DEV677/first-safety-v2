# First Safety v2 — optional Gemini matching layer (§8).
# The app is complete and fully functional without this. Leave it unset and the
# offline keyword matcher + tap list handle everything.
#
# The key is read ONLY by the Vercel serverless function at /api/match.ts.
# It must never appear in the client bundle, in this repo, or in a screenshot.
# Set the real value in Vercel → Project → Settings → Environment Variables.

GEMINI_API_KEY=
